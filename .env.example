PLANTOPS_TOP_K=5
PLANTOPS_MIN_SCORE=0.20
PLANTOPS_CHUNK_SIZE=180
PLANTOPS_CHUNK_OVERLAP=35
PLANTOPS_GENERATOR=extractive
PLANTOPS_EMBEDDING_BACKEND=hash
PLANTOPS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PLANTOPS_LLM_TIMEOUT_SECONDS=30
PLANTOPS_OLLAMA_BASE_URL=http://127.0.0.1:11434
PLANTOPS_OLLAMA_MODEL=llama3.2:3b
PLANTOPS_OPENAI_BASE_URL=https://api.openai.com
PLANTOPS_OPENAI_MODEL=gpt-4.1-mini
PLANTOPS_MAX_UPLOAD_BYTES=10000000
PLANTOPS_ALLOW_UPLOADS=true
